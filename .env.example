# 환경변수 예시
# 실제 값은 .env.local에 입력하고 이 파일에는 secret을 넣지 마세요.

# ── 공개 가능 (NEXT_PUBLIC_) ──────────────────────────────

# 사이트 절대 URL (끝 슬래시 없이, canonical·sitemap·OG·JSON-LD 기준)
# - 로컬 개발: http://localhost:3000
# - 운영(권장): https://lawfirmguide.co.kr
# - Vercel Production Environment Variables에도 동일하게 설정
# - www / *.vercel.app 을 canonical로 쓰지 말 것
NEXT_PUBLIC_SITE_URL=https://lawfirmguide.co.kr

# 카카오 제휴·문의 링크
NEXT_PUBLIC_KAKAO_AD_URL=http://pf.kakao.com/_DSgxfb/chat

# 모바일 상담전화 (화면 미노출, tel: 링크용 숫자만)
NEXT_PUBLIC_PHONE_TEL=02-739-5415

# 검색엔진 소유권 인증 (발급 후 입력, 빈 값이면 태그 미출력)
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Supabase 클라이언트용 (상담폼 활성화 시, RLS 검토 필수)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 비공개 (서버 전용, NEXT_PUBLIC_ 금지) ────────────────

# IndexNow
# - public/d0aac18d3286c5e67acd15d78de3ee90.txt 가 있으면 스크립트가 자동 탐지한다.
# - Vercel Production에는 INDEXNOW_KEY를 동일 값으로 설정하는 것을 권장한다.
# - 배포 후 /feed.xml 200 확인 뒤 npm run indexnow 실행 (배포 전 제출 금지)
# - 로컬 점검: npm run indexnow -- --dry-run
INDEXNOW_KEY=d0aac18d3286c5e67acd15d78de3ee90
INDEXNOW_KEY_LOCATION=https://lawfirmguide.co.kr/d0aac18d3286c5e67acd15d78de3ee90.txt

# Google Sheets 상담폼 (Apps Script Web App URL)
GOOGLE_SHEETS_WEB_APP_URL=

# Google Sheets shared secret (서버 검증용)
GOOGLE_SHEETS_SHARED_SECRET=

# Supabase service role (서버 전용, 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=
